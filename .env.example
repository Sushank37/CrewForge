# CrewForge Configuration Example
# Copy to .env for local development. Never commit .env or real API keys.

# Active provider: "ollama" or "openai"
CREWFORGE_PROVIDER=ollama

# Model identifier (local candidate: qwen3:4b; cloud model must be configured explicitly)
CREWFORGE_MODEL=qwen3:4b

# OpenAI credentials (placeholder only; do not commit real secrets)
CREWFORGE_OPENAI_API_KEY=your-openai-api-key-here
# Optional OpenAI-compatible base URL override
# CREWFORGE_OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama local server endpoint and inference controls
CREWFORGE_OLLAMA_BASE_URL=http://127.0.0.1:11434
CREWFORGE_OLLAMA_NUM_CTX=4096
# Set to false to disable thinking trace on compatible models (e.g., qwen3:4b)
CREWFORGE_OLLAMA_THINK=false

# Request execution controls (local 8GB M1 defaults: concurrency=1, retries=0)
CREWFORGE_REQUEST_TIMEOUT_SECONDS=60.0
CREWFORGE_RUN_DEADLINE_SECONDS=300.0
CREWFORGE_MAX_RETRIES=0
CREWFORGE_MAX_CONCURRENCY=1
CREWFORGE_MAX_OUTPUT_TOKENS=1024

# Optional per-operation output token overrides (always bounded by MAX_OUTPUT_TOKENS)
# CREWFORGE_PLANNER_MAX_OUTPUT_TOKENS=768
# CREWFORGE_WORKER_MAX_OUTPUT_TOKENS=768
# CREWFORGE_SYNTHESIS_MAX_OUTPUT_TOKENS=1024

# Multi-agent network limits
CREWFORGE_MAX_WORKERS=4
CREWFORGE_MAX_TASKS=6
CREWFORGE_MAX_COMMUNICATION_ROUNDS=1
CREWFORGE_MAX_MESSAGE_CHARS=1000

# Budget and call limits (USD)
CREWFORGE_MAX_MODEL_CALLS_PER_RUN=16
CREWFORGE_MAX_COST_PER_RUN_USD=0.05
CREWFORGE_MAX_CUMULATIVE_COST_USD=1.00

# Optional per-model pricing map in JSON (USD per 1M tokens).
# Paid providers fail closed when pricing for the target model is absent.
# Example: {"gpt-4.1-mini":{"input_per_1m":0.40,"output_per_1m":1.60}}
CREWFORGE_PRICING_JSON={}

# Local SQLite database path
CREWFORGE_DB_PATH=.crewforge/crewforge.db

# Logging level (written to stderr only so MCP stdio remains clean)
CREWFORGE_LOG_LEVEL=INFO
